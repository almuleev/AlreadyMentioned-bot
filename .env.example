# Скопируйте в .env и укажите токен, полученный у BotFather.
TELEGRAM_BOT_TOKEN=
DATABASE_PATH=data/already_mentioned.db
# hybrid: FRIDA + MiniLM; baseline: исходный поиск FRIDA.
SEARCH_MODE=hybrid
# Необязательно: прокси для Docker, если Telegram недоступен напрямую.
# HTTPS_PROXY=http://host.docker.internal:PORT
